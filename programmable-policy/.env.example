# --- Dfns API ---
# Authenticated as the SERVICE ACCOUNT that will auto-approve / reject the
# pending requests. Do NOT use the maker's credentials here.
DFNS_API_URL='https://api.dfns.io'
DFNS_ORG_ID='or-your-org-id'
DFNS_CRED_ID='your-service-account-cred-id'
DFNS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----'
DFNS_AUTH_TOKEN='your-service-account-auth-token'

# --- Wallet & policy ---
# Wallet that broadcasts the transactions (the "Maker"). Tag this wallet so
# the policy filter (walletTags hasAny) targets it.
SENDER_WALLET_ID='wa-your-wallet-id'

# User listed as approver on the policy (alongside the service account).
POLICY_USER_ID='us-your-user-id'

# StableCoin contract address — populated after `npm run deploy`.
CONTRACT_ADDRESS='0x...'

# Address allowed as the `mint` recipient. All other targets are rejected.
WHITELIST_ADDRESS='0x...'
