# ============================================================================
# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# --- Auth0 (must match backend Auth0 config) ---
# These are used by the @auth0/nextjs-auth0 v4 SDK.
AUTH0_SECRET=a-long-random-string
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://bank-custody-api

# --- Backend API ---
# URL of the Flask backend. The frontend proxies API calls to this URL.
NEXT_PUBLIC_API_URL=http://localhost:5001
