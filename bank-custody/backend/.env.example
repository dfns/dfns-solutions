# ============================================================================
# Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================================

# --- Dfns Service Account ---
# Create a service account at https://app.dfns.io and copy these values.
# The backend uses this single service account to manage ALL customer wallets.
DFNS_API_URL=https://api.dfns.io
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY=

# --- Auth0 ---
# The backend verifies JWTs using Auth0's public JWKS. No client secret needed.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://bank-custody-api

# --- Transfer Approval ---
# Transfers at or above this amount (in ETH) require bank employee approval.
# Set to a low value (e.g. 0.05) for demo purposes.
APPROVAL_THRESHOLD=1000
