# DFNS credentials — find these in app.dfns.io under Settings > Developers > Service Accounts
DFNS_API_URL=https://api.dfns.io
DFNS_ORG_ID=
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY=

# Wallet IDs — create three wallets (EVM / Sepolia) in app.dfns.io
BANK_WALLET_ID=
SENDER_WALLET_ID=
RECEIVER_WALLET_ID=

# RPC URL for Sepolia (optional — defaults to a public node if unset)
BLOCKCHAIN_RPC_URL=
