# Dfns org
DFNS_API_URL=https://api.dfns.io
DFNS_ORG_ID=

# Service account that runs the custody backend
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY=

# The two withdrawal approvers (us-..., comma-separated). Each needs the
# Policies:Evaluations:Vote permission. One of the two approves a withdrawal,
# and never the person who requested it.
APPROVER_USER_IDS=

# Automatic checker: a second service account whose role only has
# Policies:Evaluations:Read and Policies:Evaluations:Vote. Never reuse the
# backend's credentials here. `npm run setup` adds CHECKER_USER_ID to the
# withdrawal approvers.
CHECKER_USER_ID=
CHECKER_AUTH_TOKEN=
CHECKER_CRED_ID=
CHECKER_PRIVATE_KEY=

# The checker approves a withdrawal only if the amount (wei) is at most the cap
# and the destination is on the allowlist (0x..., comma-separated). Anything
# else it leaves for a human.
CHECKER_MAX_AMOUNT_WEI=10000000000000000
CHECKER_ALLOWLIST=

# Validation Gate (npm run gate, npm run simulate). No Dfns credentials needed.
# Shared secret with the signer: 32 bytes as hex, from `openssl rand -hex 32`.
GATE_SHARED_SECRET=
GATE_PORT=4000
# The gate lets a key sign a transfer only if it is native ETH, the amount
# (wei) is at most the cap and the destination is on the allowlist (0x...,
# comma-separated). Empty allowlist: every transfer is rejected.
GATE_MAX_AMOUNT_WEI=10000000000000000
GATE_ALLOWLIST=
# Optional business hours, e.g. 08-20 (from 08:00 to 19:59), in GATE_TIMEZONE
# (IANA name, default UTC). Empty: any time.
GATE_HOURS=
GATE_TIMEZONE=UTC
# Key exports and requests without an intent (raw signatures) are rejected
# unless set to true
GATE_ALLOW_KEY_EXPORT=false
GATE_ALLOW_NO_INTENT=false
# Where the simulator sends requests (default http://localhost:$GATE_PORT/validate)
GATE_URL=

# Dfns resources (Ethereum Sepolia). `npm run setup` creates any left empty.
VAULT_ID=
WITHDRAWAL_POLICY_ID=
QUARANTINE_POLICY_ID=
