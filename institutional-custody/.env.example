# Dfns org
DFNS_API_URL=https://api.dfns.io
DFNS_ORG_ID=

# Service account that runs the custody backend
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY=

# The three withdrawal approvers (us-..., comma-separated). Each needs the
# Policies:Evaluations:Vote permission. Two of the three approve a withdrawal.
APPROVER_USER_IDS=

# Dfns resources (Ethereum Sepolia). `npm run setup` creates any left empty.
VAULT_ID=
WITHDRAWAL_POLICY_ID=
QUARANTINE_POLICY_ID=
