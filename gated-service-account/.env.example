# Admin identity (a service account or user that can create keys, wallets,
# policies, permissions, and vote on approvals). Use a development organization.
DFNS_API_URL=https://api.dfns.io
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Approval group for the policy (read by `npm run setup`).
# QUORUM: number of approvals required (default 1).
QUORUM=1
# APPROVER_USER_IDS: comma-separated user ids allowed to approve. Leave empty to
# allow any human user in the org. Required if SERVICE_ACCOUNT_APPROVERS=true.
APPROVER_USER_IDS=
# INITIATOR_CAN_APPROVE: allow the identity that requested the signature to also
# approve it. Keep true only for a single-identity demo; set false in production.
INITIATOR_CAN_APPROVE=true
# SERVICE_ACCOUNT_APPROVERS: set true only if an approver is itself a service
# account. The engine then requires the approver to be listed in APPROVER_USER_IDS.
SERVICE_ACCOUNT_APPROVERS=false

# Filled in after the manual dashboard step in `npm run setup`.
# The access token shown once when you create the gated service account.
GATED_SA_TOKEN=

# Runtime behavior (read by `npm run go`).
# AUTO_APPROVE=true casts the approval vote as the admin identity for an
# unattended demo. Set false to approve from the dashboard instead.
AUTO_APPROVE=true
