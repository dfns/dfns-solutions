# --- Dfns API ---
# Service account credentials. The scripts run as this identity to sign on
# behalf of the customer wallet and to broadcast settlement from the merchant
# wallet.
DFNS_API_URL='https://api.dfns.io'
DFNS_ORG_ID='or-your-org-id'
DFNS_CRED_ID='your-service-account-cred-id'
DFNS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----'
DFNS_AUTH_TOKEN='your-service-account-auth-token'

# --- Wallets ---
# Customer (Payer) wallet — holds USDC and signs the X402 authorization.
DFNS_CUSTOMER_WALLET_ID='wa-customer-wallet-id'
# Merchant (Payee + Facilitator) wallet — broadcasts the settlement and pays gas.
DFNS_MERCHANT_WALLET_ID='wa-merchant-wallet-id'

# --- On-chain configuration ---
# Address that receives the USDC and that broadcasts the settlement transaction.
# Must equal the address of DFNS_MERCHANT_WALLET_ID (USDC enforces msg.sender == payee).
MERCHANT_ADDRESS='0x...'
# USDC contract address. Defaults below are for Ethereum Sepolia.
USDC_CONTRACT_ADDRESS='0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238'
CHAIN_ID=11155111
