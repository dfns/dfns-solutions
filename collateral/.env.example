# Dfns org
DFNS_API_URL=https://api.dfns.io
DFNS_ORG_ID=

# Service account, shared by the borrower and the lender for the demo
DFNS_AUTH_TOKEN=
DFNS_CRED_ID=
DFNS_PRIVATE_KEY=

# Dfns resources (Ethereum Sepolia). `npm run setup` creates any left empty.
# Each actor holds everything in one vault (vlt-...). No wallets needed.
BORROWER_VAULT_ID=
LENDER_VAULT_ID=

# PYUSD ERC-20 on Sepolia (Paxos test contract, verify before use)
PYUSD_CONTRACT=0xCaC524BcA292aaade2DF8A05cC58F0a65B1B3bB9

# Web server port
PORT=3000
