# --- HTTP server ---
PORT=4021

# --- Network (advertised in /supported) ---
NETWORK=base:sepolia
NETWORK_CAIP=eip155:84532
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ASSET_DECIMALS=6

# --- Local mode (local testing without Dfns) ---
# Set LOCAL_MODE=true to skip Dfns entirely. POST /sessions always verifies the
# approve tx for real on-chain regardless of this flag. What differs is /settle:
#   - LOCAL_MERCHANT_ADDRESS only: /settle returns a fake tx hash, nothing broadcasts.
#   - LOCAL_MERCHANT_ADDRESS + MERCHANT_PRIVATE_KEY: /settle broadcasts a REAL
#     transferFrom signed by that raw key instead of Dfns. Use a throwaway
#     Base Sepolia key here — never one holding real funds.
# See README.md "Local testing without Dfns". Leave LOCAL_MODE unset/false and
# fill in the Dfns section below for the real flow (required before this is a
# real demo again).
LOCAL_MODE=false
LOCAL_MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=

# --- Dfns API ---
# Service account credentials for the MERCHANT/spender wallet only. The
# customer's one-time approve is signed by whatever wallet the caller
# connects client-side (e.g. MetaMask) — POST /sessions verifies that tx
# on-chain rather than broadcasting it itself. See routes/sessions.ts.
# Required unless LOCAL_MODE=true.
DFNS_API_URL='https://api.dfns.io'
DFNS_ORG_ID='or-your-org-id'
DFNS_CRED_ID='your-service-account-cred-id'
DFNS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----'
DFNS_AUTH_TOKEN='your-service-account-auth-token'

# --- Wallet ---
# Merchant (Payee + Facilitator/spender) wallet — broadcasts transferFrom() per settled payment.
# Required unless LOCAL_MODE=true.
DFNS_MERCHANT_WALLET_ID='wa-merchant-wallet-id'
