# This app holds no Dfns credentials — it only talks to the standalone
# facilitator service (../../facilitator), which is the thing that holds
# Dfns credentials for the merchant wallet. Start that service first; see its
# README. The customer side connects a browser wallet (e.g. MetaMask) instead
# of using Dfns — no credentials needed for that side either.

# Base URL of the running facilitator.
FACILITATOR_URL=http://localhost:4021

# Network string sent in paymentRequirements to the facilitator's /settle.
NETWORK=base:sepolia

# The session's sole recipient AND the ERC20 approve `spender` — must match
# the facilitator's Dfns merchant wallet address. Prefixed NEXT_PUBLIC_
# because the browser needs it too, to build the approve tx client-side.
NEXT_PUBLIC_MERCHANT_ADDRESS='0x...'

# USDC contract on the target chain (must match the facilitator's config).
# Also needed client-side to send the approve tx to the right contract.
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS='0x036CbD53842c5426634e7929541eC2318f3dCF7e'

# Price per lever pull, in USDC base units (6 decimals). 100000 = 0.10 USDC.
# Must be within the facilitator's maxPerCall for sessions this app opens.
PER_PULL_BASE_UNITS=100000
