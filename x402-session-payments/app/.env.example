# --- Dfns API ---
# Service account credentials. The scripts run as this identity to broadcast
# the one-time approve from the customer wallet and every transferFrom
# settlement from the merchant (facilitator) wallet.
DFNS_API_URL='https://api.dfns.io'
DFNS_ORG_ID='or-your-org-id'
DFNS_CRED_ID='your-service-account-cred-id'
DFNS_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----'
DFNS_AUTH_TOKEN='your-service-account-auth-token'

# --- Wallets ---
# Customer (Payer) wallet — broadcasts the ONE approve(spender, budget) that opens a session.
DFNS_CUSTOMER_WALLET_ID='wa-customer-wallet-id'
# Merchant (Payee + Facilitator/spender) wallet — broadcasts transferFrom() per settled payment.
DFNS_MERCHANT_WALLET_ID='wa-merchant-wallet-id'

# --- On-chain configuration ---
# Address that receives the USDC. Must equal the address of DFNS_MERCHANT_WALLET_ID
# (it is also the ERC20 `spender` approved by the customer wallet).
MERCHANT_ADDRESS='0x...'
# USDC contract address. Defaults below are for Base Sepolia (Circle FiatTokenProxy v2).
USDC_CONTRACT_ADDRESS='0x036CbD53842c5426634e7929541eC2318f3dCF7e'
CHAIN_ID=84532
